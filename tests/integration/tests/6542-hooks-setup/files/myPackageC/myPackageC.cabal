cabal-version: 3.14

-- We don't use package.yaml because Hpack does not yet support build type
-- Hooks.

name:           myPackageC
version:        0.0.0
build-type:     Hooks

custom-setup
  setup-depends:
      base
    , Cabal
    , myPackageE:myPackageE-sub

library
  exposed-modules:
      LibC
  hs-source-dirs:
      src
  build-depends:
      base
  default-language: Haskell2010
